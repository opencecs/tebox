# Build products and download caches only.
# prebuilts/ is tracked (host QEMU/VirGL + android-arm64 Mesa/libdrm).
# Variant GSI system.img is downloaded at runtime into src/aosp/<variant>/images/;
# vendor.img / initramfs.img are rebuilt by ./run and are not committed.
/out/
/dist/
/downloads/

# Local machine NDK/SDK symlinks (see toolchains/README.md); never commit abs paths.
/toolchains/android-ndk
/toolchains/android-sdk

# Rebuildable guest images (inputs: qemu/vendor, qemu/busybox, qemu/init, Mesa).
src/aosp/*/images/vendor.img
src/aosp/*/images/initramfs.img
src/aosp/*/images/system.img
src/kernel/*/gki/Image

# Local host QEMU install (rebuildable via .ci/build-qemu.sh; 293MB incl. raw
# edk2 firmware already tracked as .fd.bz2 under qemu/pc-bios/).
/prebuilts/host/darwin-arm64/qemu/

# Mesa build output (staging copy of prebuilts/android-arm64/mesa; rebuildable
# via .ci/build-mesa-android.sh).
/thirdparty/mesa/prebuilt/

*.log

# Local secrets / editor settings (project keybox under hardware/ is tracked).
.env
.env.*
*.key
*.p12
*.pfx
*.jks
/secrets/
/.claude/settings.local.json
/.gemini/settings.json
/.cursor/worktrees.json
/.codebuddy/settings.local.json
AGENTS.override.md

# Editor/OS caches.
.DS_Store
._*
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.swp
*.swo
*~
/.idea/
/.vscode/

# Claude Code runtime state.
/.claude/scheduled_tasks.lock
src/aosp/*/images/system.img.orig-mtk
