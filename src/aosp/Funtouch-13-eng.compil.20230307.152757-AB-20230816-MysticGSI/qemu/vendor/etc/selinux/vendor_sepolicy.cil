;; QEMU bring-up: user GSI forces enforcing — mark boot domains permissive.
(typepermissive ueventd)
(typepermissive apexd)
(typepermissive init)
(typepermissive kernel)
(typepermissive vendor_init)
(typepermissive servicemanager)
(typepermissive hwservicemanager)
(typepermissive vold)
(typepermissive vdc)
(typepermissive fsck)
(typepermissive logd)
(typepermissive zygote)
(typepermissive system_server)
(typepermissive surfaceflinger)
(typepermissive netd)
(typepermissive installd)
(typepermissive keystore)
(typepermissive linkerconfig)
(type hal_keymint_system)
(roletype r hal_keymint_system)
(typeattributeset domain hal_keymint_system)
(typepermissive hal_keymint_system)
(type hal_keymint_system_exec)
(roletype object_r hal_keymint_system_exec)
(typetransition init hal_keymint_system_exec process hal_keymint_system)
(typepermissive gatekeeperd)
(typepermissive lmkd)
(typepermissive adbd)
(typepermissive tombstoned)
(typepermissive gpuservice)
(typepermissive bootanim)
(typepermissive blank_screen)
(typepermissive audioserver)
(typepermissive cameraserver)
(typepermissive mediaserver)
(typepermissive drmserver)
(typepermissive incidentd)
(typepermissive statsd)
(typepermissive traced)
(typepermissive traced_probes)
(typepermissive heapprofd)
(typepermissive credstore)
(typepermissive odsign)
(typepermissive system_suspend)
(typepermissive crash_dump)
(typepermissive wait_for_keymaster)
(typepermissive storaged)
(typepermissive wificond)
(typepermissive stats)
(typepermissive bpfloader)
(typepermissive llkd)

;; Allow enforcing app clients to use the existing combined graphics service.
(typeattributeset hal_graphics_allocator_server (hal_keymint_service))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/vendor" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/device" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/class" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/revision" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/subsystem_vendor" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/subsystem_device" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/uevent" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/drm/card0/uevent" (u object_r sysfs_gpu ((s0) (s0))))
(genfscon sysfs "/devices/platform/4010000000.pcie/pci0000:00/0000:00:06.0/drm/renderD128/uevent" (u object_r sysfs_gpu ((s0) (s0))))
