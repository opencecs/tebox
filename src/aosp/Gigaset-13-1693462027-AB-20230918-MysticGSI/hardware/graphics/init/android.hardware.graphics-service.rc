service vendor.graphics-stub /vendor/bin/hw/android.hardware.graphics-service
    class early_hal
    user root
    group root
    console
    seclabel u:r:hal_keymint_system:s0
    interface aidl android.hardware.graphics.composer3.IComposer/default
    interface aidl android.hardware.graphics.allocator.IAllocator/default
